# Copy this file to .env and fill in the values. Never commit .env.

# Which broker the monthly run uses:
#   alpaca     Alpaca PAPER trading: the bot places orders itself (paper money only)
#   robinhood  ticket mode: the bot plans and writes an order ticket; you or your approved agent place it
BROKER=alpaca

# Account type decides which dividend payers are eligible:
#   taxable         (default) excludes REITs and BDCs, which pay mostly ordinary (non-qualified) dividends
#   tax_advantaged  IRA, 401(k) and similar: REITs and BDCs become eligible and Real Estate is held
# MLPs (K-1 issuers) are excluded either way. Re-run build_universe.py and compute_crown_scores.py after changing it.
ACCOUNT_TYPE=taxable

# Financial Modeling Prep (company profiles: market cap, sector, country, exchange). Free key works.
FMP_API_KEY=

# SEC EDGAR requires a contact on every request, e.g.  SEC_USER_AGENT=Jane Doe jane@example.com
SEC_USER_AGENT=

# Alpaca PAPER keys. Needed in both modes: Alpaca's free data supplies prices and dividend history.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
